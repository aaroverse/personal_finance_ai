# Copy to .env and replace every placeholder. Never commit .env.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_ALLOWED_USER_IDS=123456789
DEEPSEEK_API_KEY=replace_with_deepseek_api_key

# Optional defaults
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_CURRENCY=SGD
APP_TIMEZONE=Asia/Singapore
KNOWN_ACCOUNTS=MY UOB,MY Maybank,SG Citibank,SG UOB,SG DBS,SG OCBC,Cash
DATABASE_PATH=data/finance.db
LOG_LEVEL=INFO

# Optional: exact private Tailscale Serve origin and permitted Tailscale login.
# Can also be stored locally in data/finance.db.remote.json (git-ignored).
WEB_PUBLIC_ORIGIN=
WEB_TAILSCALE_LOGIN=
